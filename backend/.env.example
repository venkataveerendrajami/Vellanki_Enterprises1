# ====================================================================
# VELLANKI ENTERPRISES - Environment Configuration Example
# ====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=vellanki_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ====================================================================
# Database Configuration
# ====================================================================
# Option 1: Supabase (PostgreSQL Cloud Database) - RECOMMENDED FOR DEPLOYMENT
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DB_URL=

# Option 2: Local SQLite (Offline / Local Dev fallback)
# If DATABASE_URL is not set, the app will automatically use local SQLite
DB_TYPE=sqlite
DB_FILE=./database/vellanki.db

# ====================================================================
# Razorpay Payment Gateway Configuration
# Obtain test/live API keys from https://dashboard.razorpay.com/app/keys
# ====================================================================
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Default Admin Account (Auto-created if no admin exists)
ADMIN_NAME=Vellanki Admin
ADMIN_EMAIL=admin@vellanki.com
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=Admin@12345

# ====================================================================
# Brevo (formerly Sendinblue) Transactional Email API Configuration
# All verification (Login, Register, Forgot Password) is sent via Brevo
# Get your free API key from: https://app.brevo.com/settings/keys/api
# ====================================================================
BREVO_API_KEY=
BREVO_SENDER_NAME="VELLANKI ENTERPRISES"
BREVO_SENDER_EMAIL=jamilovaprasad2005@gmail.com
